# The Angular app lives in web/ and has its own .gitignore (build output,
# node_modules, .angular cache, etc.). Nothing below applies to it.

.DS_Store
*.log

# Wrangler's local cache.
.wrangler/

# Working folders that came across when this project moved here. Neither is
# part of the website:
#   ecell/     — a clone of the dhatchinamoorthiat-star/E-Cell repo (the
#                Supabase "Control Room" platform), cloned only to check
#                whether it held this site's source. It does not.
#   site-live/ — a mirror of the OLD live site (the pre-Angular static
#                build), kept as the content reference while rebuilding.
#                Every fact in it now lives in web/src/app/core/data/.
# Both are safe to delete once you are happy with the rebuild.
ecell/
site-live/

# Old build output from the retired build.mjs generator, if it ever
# reappears locally.
dist/
