# Copy to .env and adjust. Never commit .env.
# The Django settings read these as plain environment variables; load .env
# into your shell (e.g. `set -a; source .env; set +a`) before manage.py.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production; dev.py falls back to an insecure placeholder.
DJANGO_SECRET_KEY=

# docker compose up -d db  → this URL works as-is.
DATABASE_URL=postgres://ecell:ecell@localhost:5432/ecell

ALLOWED_HOSTS=localhost,127.0.0.1
# The Angular dev server's origin. In production: the site origin only.
CSRF_TRUSTED_ORIGINS=http://localhost:4200
# Where password-reset links point.
FRONTEND_URL=http://localhost:4200

# Organisation timezone default (editable later in Settings).
ORG_TIMEZONE=Asia/Kolkata

# Email. The console backend prints emails (incl. reset links) to the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before a stuck SMTP connection is abandoned (review finding F5).
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=PSGIM E-Cell <no-reply@localhost>

# Only set when running behind the Cloudflare /api proxy (ADR-004), e.g. CF-Connecting-IP.
CLIENT_IP_HEADER=
# Shared secret the proxy (functions/api/[[path]].js) attaches to every forwarded
# request. Must match PROXY_SHARED_SECRET set on the Cloudflare Pages Function.
# CLIENT_IP_HEADER is trusted only when this is set and the request's secret
# matches (review finding F4) — leave both empty in local dev.
PROXY_SHARED_SECRET=

# Cloudinary media library (Phase 2 CMS). Leave empty in local dev if you
# don't need real media uploads — the signed-upload endpoint returns a
# clear error instead of failing silently.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
