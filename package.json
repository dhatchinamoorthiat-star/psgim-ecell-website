{
  "name": "psgim-ecell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website of the Entrepreneurship Cell, PSG Institute of Management, Coimbatore.",
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web start",
    "deploy": "node tools/deploy-from-commit.mjs --target production",
    "deploy:preview": "node tools/deploy-from-commit.mjs --target preview",
    "test:functions": "node --test \"tools/tests/api-proxy.test.mjs\" \"tools/tests/preview-label.test.mjs\" \"tools/tests/deploy-from-commit.test.mjs\" \"tools/tests/site-origin.test.mjs\"",
    "test:e2e:join": "node --test \"tools/tests/join-e2e.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
